<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/mainRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_main_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- ════════════════════════════════════════════ -->
        <!-- SECTION 1: ARIA Mascot + Welcome (Animated)  -->
        <!-- ════════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/headerCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#1Affffff"
            app:cardCornerRadius="28dp"
            app:cardElevation="0dp"
            app:strokeColor="#30ffffff"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:padding="24dp"
                android:background="@drawable/bg_security_gradient">

                <!-- Animated animated mascot -->
                <ImageView
                    android:id="@+id/mascotImage"
                    android:layout_width="96dp"
                    android:layout_height="96dp"
                    android:contentDescription="ARIA mascot"
                    android:src="@drawable/ic_mascot_avatar_new" />

                <!-- Welcome text -->
                <TextView
                    android:id="@+id/welcomeText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Welcome back ✨"
                    android:textColor="@android:color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium" />

                <TextView
                    android:id="@+id/welcomeSub"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Voice-first AI assistant"
                    android:textColor="#A0B4DC"
                    android:textSize="13sp" />

                <!-- Animated logo pulse -->
                <ImageView
                    android:id="@+id/logoImage"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginTop="10dp"
                    android:contentDescription="ARIA pulse"
                    android:src="@drawable/avd_aria_logo_pulse"
                    android:alpha="0.6" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ════════════════════════════════════════════ -->
        <!-- SECTION 2: Theme Palette Gallery              -->
        <!-- ════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="10dp"
            android:text="🎨 Theme"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:id="@+id/themeGallery"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingBottom="4dp">

                <!-- Theme cards will be dynamically added by MainActivity -->
                <!-- Each card: 80dp wide mini preview circle -->
            </LinearLayout>
        </HorizontalScrollView>

        <!-- ════════════════════════════════════════════ -->
        <!-- SECTION 3: Smart Status (Setup + ARIA state)  -->
        <!-- ════════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/setupCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#15ffffff"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#2Dffffff"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_wave_24"
                        android:layout_marginEnd="8dp"
                        android:alpha="0.7" />

                    <TextView
                        android:id="@+id/setupTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Setup Health"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/setupProgressText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0/0"
                        android:textColor="#A0B4DC"
                        android:textSize="12sp" />
                </LinearLayout>

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/setupProgress"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:indicatorColor="#82A2FF"
                    app:trackColor="#30ffffff"
                    app:trackCornerRadius="4dp"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/permissionsChecklistStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🔑 Permissions"
                    android:textColor="#E0E6F8"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/overlayChecklistStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="🖼️ Display Overlay"
                    android:textColor="#E0E6F8"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />

                <TextView
                    android:id="@+id/assistantChecklistStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="📱 Default Assistant"
                    android:textColor="#E0E6F8"
                    android:textSize="13sp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ════════════════════════════════════════════ -->
        <!-- SECTION 4: Quick Actions (4 pill buttons)     -->
        <!-- ════════════════════════════════════════════ -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:text="⚡ Actions"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <!-- Row 1: Voice + Chat -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/voiceActionButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="🎤 Voice"
                android:textSize="15sp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:backgroundTint="#4CAF50" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/chatActionButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="💬 Chat"
                android:textSize="15sp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:backgroundTint="#2196F3" />
        </LinearLayout>

        <!-- Row 2: Tasks + Settings -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/taskManagerButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginEnd="6dp"
                android:text="📋 Tasks"
                android:textSize="15sp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:backgroundTint="#9C27B0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/settingsButton"
                android:layout_width="0dp"
                android:layout_height="56dp"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:text="⚙️ Settings"
                android:textSize="15sp"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                app:cornerRadius="28dp"
                app:backgroundTint="#FF9800" />
        </LinearLayout>

        <!-- ════════════════════════════════════════════ -->
        <!-- SECTION 5: Brain Panel (ARIA Memory + Model)  -->
        <!-- ════════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/brainCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#10ffffff"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#25ffffff"
            app:strokeWidth="1dp"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="10dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_settings_24"
                        android:layout_marginEnd="8dp"
                        android:alpha="0.5" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🧠 ARIA Brain"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/brainStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Model: —  •  Memory: — topics"
                    android:textColor="#A0B4DC"
                    android:textSize="13sp"
                    android:layout_marginBottom="6dp" />

                <com.google.android.material.progressindicator.LinearProgressIndicator
                    android:id="@+id/brainMemoryBar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:indicatorColor="#B69CFF"
                    app:trackColor="#25ffffff"
                    app:trackCornerRadius="3dp"
                    android:progress="0" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- ════════════════════════════════════════════ -->
        <!-- SECTION 6: Recent Alerts                      -->
        <!-- ════════════════════════════════════════════ -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/alertsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardBackgroundColor="#10ffffff"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeColor="#25ffffff"
            app:strokeWidth="1dp"
            android:layout_marginBottom="20dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_tasks_24"
                        android:layout_marginEnd="8dp"
                        android:alpha="0.5" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="🔔 Recent Alerts"
                        android:textColor="@android:color/white"
                        android:textSize="15sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/alertCountText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0"
                        android:textColor="#F44336"
                        android:textSize="12sp"
                        android:background="@drawable/bg_security_badge_strict"
                        android:paddingHorizontal="8dp"
                        android:paddingVertical="2dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/lastAlertText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="No recent alerts"
                    android:textColor="#808090"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:paddingVertical="12dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
