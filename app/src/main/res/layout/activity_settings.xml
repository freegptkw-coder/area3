<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#1E1E1E"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="💕 Personality Mode"
            android:textColor="#FF69B4"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <Spinner
            android:id="@+id/personalitySpinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="👤 Personal Info"
            android:textColor="#64B5F6"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Your Name"
            app:boxBackgroundColor="#2D2D2D"
            android:layout_marginBottom="16dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/userNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Nickname (জান, সোনা, etc.)"
            app:boxBackgroundColor="#2D2D2D"
            android:layout_marginBottom="16dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/nicknameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#FFFFFF"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Custom System Prompt (Be open-minded, etc.)"
            app:boxBackgroundColor="#2D2D2D"
            android:layout_marginBottom="24dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/customSystemPromptInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minLines="3"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:textColor="#FFFFFF"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚡ AI Provider"
            android:textColor="#FFA726"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <Spinner
            android:id="@+id/providerSpinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🤖 Model"
            android:textColor="#4CAF50"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <Spinner
            android:id="@+id/modelSpinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="🔑 AI API Key"
            app:boxBackgroundColor="#2D2D2D"
            app:endIconMode="password_toggle"
            android:layout_marginBottom="24dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/apiKeyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="#FFFFFF"/>
        </com.google.android.material.textfield.TextInputLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎤 Voice Provider"
            android:textColor="#E91E63"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <Spinner
            android:id="@+id/ttsProviderSpinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🗣️ Voice Selection"
            android:textColor="#9C27B0"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <Spinner
            android:id="@+id/voiceSpinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="24dp"/>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Custom Voice ID (optional override)"
            app:boxBackgroundColor="#2D2D2D"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/customVoiceIdInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textNoSuggestions"
                android:textColor="#FFFFFF"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Custom Voice Name (optional)"
            app:boxBackgroundColor="#2D2D2D"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/customVoiceNameInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textCapWords"
                android:textColor="#FFFFFF"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.textfield.TextInputLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="🔑 Voice API Key (ElevenLabs/Cartesia)"
            app:boxBackgroundColor="#2D2D2D"
            app:endIconMode="password_toggle"
            android:layout_marginBottom="12dp">
            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/voiceApiKeyInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPassword"
                android:textColor="#FFFFFF"/>
        </com.google.android.material.textfield.TextInputLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/voiceTestButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Test Voice Key + Voice ID" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎧 Speech Recognition"
            android:textColor="#26C6DA"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <Spinner
            android:id="@+id/speechLanguageSpinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="24dp"/>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🔔 Proactive Features"
            android:textColor="#AB47BC"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💕 Care Notifications"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/proactiveSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🌙 Dark Mode"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/themeSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"/>
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🎨 Theme Engine"
            android:textColor="#CDA8FF"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <Spinner
            android:id="@+id/themeModeSpinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="12dp"/>

        <Spinner
            android:id="@+id/themePaletteSpinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="16dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔔 Read notifications aloud"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/notificationReadAloudSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="💬 Auto read incoming SMS"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/smsReadAloudSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📥 Notification listener enabled"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/notificationListenerSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎧 Wake Word (Hey ARIA)"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/wakeWordSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🇧🇩 Bangla Priority Mode"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/banglaModeSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🛡 Safe Root Guard"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/safeRootSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔴 Live Mode (Foreground Mic)"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/liveModeSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="♾️ Always-on Background Live"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/liveAlwaysOnSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="16dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="👁 Live Vision Loop (Opt-in only)"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/liveVisionSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"/>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/rootSafetyCenterButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:text="Open Root Safety Center" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/liveSafetyCenterButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="Open Live Safety Center" />

        <!-- ========== v3.0 New Features Section ========== -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="🚀 v3.0 Smart Features"
            android:textColor="#FF9800"
            android:textSize="18sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🔋 Smart Battery Optimizer"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/v3BatteryOptimizerSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📍 Location Reminders"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/v3LocationRemindersSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📞 Call Screen &amp; Auto-Answer"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/v3CallScreeningSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🎵 Voice Music Control"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/v3MusicControlSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🗣️ Voice Profile Enrollment"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/v3VoiceProfileSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="🧠 Context Tracking (last 3 topics)"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/v3ContextTrackingSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="true"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="8dp">
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="📴 Offline STT (Vosk)"
                android:textColor="#FFFFFF"
                android:textSize="16sp"/>
            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/v3OfflineSttSwitch"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:checked="false"/>
        </LinearLayout>

        <!-- Model language selection -->
        <TextView
            android:id="@+id/v3ModelLangLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Model Language"
            android:textColor="#888888"
            android:textSize="14sp"
            android:layout_marginBottom="8dp"
            android:paddingStart="16dp"/>

        <Spinner
            android:id="@+id/v3ModelLangSpinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="12dp"/>

        <!-- Download button + progress -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/v3DownloadModelButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="📥 Download Model" />

        <!-- Progress bar + status -->
        <LinearLayout
            android:id="@+id/v3ModelDownloadProgress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:background="#1Affffff"
            android:padding="12dp"
            android:layout_marginBottom="12dp">

            <ProgressBar
                android:id="@+id/v3ModelProgressBar"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:max="200"/>

            <TextView
                android:id="@+id/v3ModelStatusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Waiting..."
                android:textColor="#AAAAAA"
                android:textSize="12sp"/>
        </LinearLayout>

        <!-- Storage info -->
        <LinearLayout
            android:id="@+id/v3ModelStorageInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="#1Affffff"
            android:padding="12dp"
            android:layout_marginBottom="12dp">
            <TextView
                android:id="@+id/v3ModelStorageText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="No models downloaded"
                android:textColor="#888888"
                android:textSize="12sp"/>
            <com.google.android.material.button.MaterialButton
                android:id="@+id/v3DeleteModelButton"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🗑️ Delete"
                android:textColor="#F44336"/>
        </LinearLayout>

        <Spinner
            android:id="@+id/v3SttLanguageSpinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#2D2D2D"
            android:padding="16dp"
            android:layout_marginBottom="16dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/v3RequestPermissionsButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textColor="#FF5722"
            app:strokeColor="#FF5722"
            android:text="🔐 Request v3.0 Runtime Permissions" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/v3DataPrivacyButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            android:text="🔒 Data Privacy &amp; Opt-Out" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/saveButton"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="💾 Save Settings"
            android:textSize="16sp"
            app:cornerRadius="12dp"
            app:backgroundTint="#4CAF50"/>

    </LinearLayout>
</ScrollView>
