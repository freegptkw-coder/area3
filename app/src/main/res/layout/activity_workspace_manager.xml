<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="16dp"
    android:background="#1E1E1E">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="📁 Workspace Manager"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginBottom="10dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Default permission mode"
            android:textColor="#B0BEC5"
            android:textSize="13sp"
            android:layout_marginBottom="6dp" />

        <Spinner
            android:id="@+id/workspaceModeSpinner"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:background="#2D2D2D"
            android:padding="12dp"
            android:layout_marginBottom="14dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/openProjectButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Open Project (SAF Folder)"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/importFolderButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Import Folder"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/importZipButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Import ZIP"
            android:layout_marginBottom="8dp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/exportLatestButton"
            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Export Latest Workspace"
            android:layout_marginBottom="16dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Recent Workspaces"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <ListView
            android:id="@+id/recentWorkspaceList"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:divider="#303030"
            android:dividerHeight="1dp"
            android:background="#2A2A2A"
            android:layout_marginBottom="14dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Persisted Access Grants"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <ListView
            android:id="@+id/grantsList"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:divider="#303030"
            android:dividerHeight="1dp"
            android:background="#2A2A2A" />

    </LinearLayout>
</ScrollView>
